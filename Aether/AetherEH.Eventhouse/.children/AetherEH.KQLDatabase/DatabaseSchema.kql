// ============================================================
// Ghost in the Aether — KQL Database Schema
// Eventhouse: AetherEH | Database: AetherEH
// ============================================================

// --- Security Logs ---
// Real-time access events from the Aetherium Estate security system
.create-merge table SecurityLogs (
    Timestamp: datetime,
    PersonID: int,
    LocationID: int,
    EventType: string
)

// --- Communications ---
// Intercepted messages between persons of interest
.create-merge table Communications (
    Timestamp: datetime,
    CommsType: string,
    Sender: string,
    Recipient: string,
    Subject: string,
    Body: string,
    Status: string
)

// --- VictimCalendar ---
// Julian Croft's schedule in the 48 hours before his death
.create-merge table VictimCalendar (
    StartTime: datetime,
    EndTime: datetime,
    Subject: string,
    Attendees: dynamic,
    Status: string
)

// --- SupplierRecords ---
// Deliveries and external access to the estate
.create-merge table SupplierRecords (
    OrderDate: datetime,
    Supplier: string,
    ItemCode: string,
    ItemDescription: string,
    Quantity: int,
    Notes: string
)

// --- Audience Votes ---
// Live "whodunit" guesses collected from MS Forms during the demo.
// Streamed in via: MS Form -> Azure Logic App -> AetherES CustomEndpoint -> this table.
// Pattern credited to https://github.com/liamhowlett/fabric-rti-livesurvey
// VoteSection distinguishes voting rounds (e.g. "Final Vote"); Suspect is the guess.
.create-merge table Votes (
    ResponseId: string,
    Timestamp: datetime,
    VoterName: string,
    VoteSection: string,
    Suspect: string
)
