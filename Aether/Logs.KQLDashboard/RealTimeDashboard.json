  "queries": [
    {
      "id": "61eb2019-2fde-40fa-9793-4e204e611433",
      "text": "SecurityLogs\n| summarize EventCount = count() by bin(Timestamp, 1m), EventType",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "0d5ae7f7-8c14-4ccb-90f0-7bcacc14f51e",
      "text": "SecurityLogs\n| summarize EventCount = count() by PersonID",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "887695dd-ad12-49a2-887e-cf86414b38f8",
      "text": "SecurityLogs\n| summarize EventCount = count() by LocationID",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "ce14a2b0-f228-4ecf-82b6-a9349589ceeb",
      "text": "SecurityLogs\n| where EventType has 'suspicious' or EventType has 'alert'\n| project Timestamp, PersonID, LocationID, EventType\n| order by Timestamp desc\n| take 50",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "cbc890e6-1e57-4ba3-9c2e-d8cc71daf863",
      "text": "Communications\n| summarize MsgCount = count() by bin(Timestamp, 1m), CommsType",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "95baca0b-e01b-4baa-883d-2c349f2582f5",
      "text": "Communications\n| summarize MessageCount = count() by Sender, Recipient\n| order by MessageCount desc",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "79b4ac8e-5a16-4c63-959e-4111be2a8d13",
      "text": "Communications\n| summarize Count = count() by Status",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "7a106b07-54c0-4b67-bdc7-c051c095fe95",
      "text": "Communications\n| project Timestamp, Sender, Recipient, CommsType, Subject, Status\n| order by Timestamp desc\n| take 50",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "a1ab922f-3220-45fb-a317-ed041f9a0e50",
      "text": "Votes\n| summarize VoteCount = count() by Suspect\n| order by VoteCount desc",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "1f39f830-822e-46a4-a2e5-0d8f83e8df94",
      "text": "Votes\n| summarize AvgConfidence = avg(Confidence), VoteCount = count() by Suspect\n| order by VoteCount desc",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    },
    {
      "id": "c304b5bc-88de-470d-ad81-089b3ceb73de",
      "text": "Votes\n| project Timestamp, Suspect, Confidence, Motive\n| order by Timestamp desc\n| take 25",
      "usedVariables": [],
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "57a3d956-526b-4774-8f3d-1e58597da6be"
      }
    }
  ],
